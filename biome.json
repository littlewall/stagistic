{
    "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
    "files": {
        "includes": [
            "apps/landing/**/*.astro"
        ]
    },
    "formatter": {
        "enabled": true,
        "bracketSpacing": false,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineEnding": "lf",
        "lineWidth": 160
    },
    "html": {
        "experimentalFullSupportEnabled": true,
        "formatter": {
            "enabled": true
        },
        "linter": {
            "enabled": true
        }
    },
    "javascript": {
        "formatter": {
            "arrowParentheses": "asNeeded",
            "quoteStyle": "single",
            "semicolons": "always",
            "trailingCommas": "all"
        }
    }
}
