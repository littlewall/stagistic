{
    "extends": "@dvdevcz/typescript-config",
    "compilerOptions": {
      "incremental": true,
      "checkJs": true,
      "skipLibCheck": true,
      "target": "es6",
      "experimentalDecorators": true,
      "emitDecoratorMetadata": true,
      "esModuleInterop": true,
      "paths": {
        "~util/*": ["./app/util/*"],
        "~config/*": ["./app/config/*"],
        "~lib/*": ["./app/lib/*"],
        "~types/*": ["./app/types/*"],
        "~assets/*": ["./app/assets/*"],
        "~schemas/*": ["./app/schemas/*"],
        "~components/*": ["./app/components/*"],
      },
      "module": "ESNext",
      "moduleResolution": "Bundler",
      "maxNodeModuleJsDepth": 10,
      "typeRoots": [
          "./types",
          "./node_modules/@types"
      ]
    },
    "include": [
        "./app/**/*",
        "./eslint.config.mjs",
        "./stylelint.config.mjs",
        "./postcss.config.mjs",
        "./src/**/*.d.ts",
        "./.config/**/*.ts",
        "./scripts/**/*.ts",
        "./vite.config.ts",
        "./mikro-orm.config.ts",
        "./auth.config.ts",
        "./migrations/**/*.ts", "types/vite-env.d.ts", "types/eslint.d.ts",
    ]
}
