# Local HTTPS for the apps (3rd level) and services (4th level, *.api.*).
# One mkcert certificate covers all names (infra/README.md).
{
	admin off
}

(local_tls) {
	tls /etc/caddy/certs/stagistic.local.pem /etc/caddy/certs/stagistic.local-key.pem
}

editor.stagistic.local {
	import local_tls
	reverse_proxy host.docker.internal:3000
}

auth.api.stagistic.local {
	import local_tls
	reverse_proxy server:8787
}

sync.api.stagistic.local {
	import local_tls
	reverse_proxy server:8788
}

# Attachment bucket (RustFS). The Host header is kept: presigned URLs are signed for it.
files.api.stagistic.local {
	import local_tls
	reverse_proxy s3:9000
}
