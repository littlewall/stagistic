{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:stagistic:stepkg:title-page:v1",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "logo": {
            "type": "object",
            "additionalProperties": false,
            "required": ["dataUrl", "filename", "mimeType", "widthPx", "heightPx", "sizeBytes"],
            "properties": {
                "dataUrl": {"type": "string", "pattern": "^data:image/(png|jpeg);base64,", "maxLength": 2796300},
                "filename": {"type": "string", "minLength": 1},
                "mimeType": {"enum": ["image/jpeg", "image/png"]},
                "widthPx": {"type": "number", "exclusiveMinimum": 0},
                "heightPx": {"type": "number", "exclusiveMinimum": 0},
                "sizeBytes": {"type": "integer", "minimum": 1, "maximum": 2097152}
            }
        },
        "subtitle": {"type": "string"},
        "credits": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["credit", "authors"], "properties": {"credit": {"type": "string"}, "authors": {"type": "array", "items": {"type": "string"}}}}},
        "source": {"type": "string"},
        "draftDateMode": {"enum": ["auto", "manual"]},
        "draftDate": {"type": "string"},
        "dateFormat": {"enum": ["dmy", "mdy"]},
        "contact": {"type": "string"},
        "copyright": {"type": "string"}
    }
}
