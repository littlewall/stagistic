# Cloud sync against the local stack (docker-compose.dev.yml, infra/README.md).
# Behind a non-default HTTPS port, override in .env.development.local
# (e.g. https://auth.api.stagistic.local:8443).
VITE_AUTH_URL=https://auth.api.stagistic.local
VITE_SYNC_URL=https://sync.api.stagistic.local
# Cloudflare's always-pass Turnstile test site key.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
