{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "jsx": "react-jsx",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "outDir": "./dist",
        "paths": {
            "~db": ["./src/db/index.ts"],
            "~db/*": ["./src/db/*"],
            "~repo": ["./src/repo/index.ts"],
            "~repo/*": ["./src/repo/*"]
        }
    },
    "include": [
        "src",
        "vite.config.ts"
    ],
    "references": []
}
