{
    "$schema": "https://schema.tauri.app/config/3",
    "productName": "Stagistic Editor",
    "version": "0.1.0",
    "identifier": "com.stagistic.editor",
    "build": {
        "beforeDevCommand": "pnpm exec moon run desktop:dev-ui",
        "beforeBuildCommand": "pnpm exec moon run desktop:build-ui",
        "devUrl": "http://localhost:5173",
        "frontendDist": "../dist",
        "removeUnusedCommands": true
    },
    "app": {
        "windows": [
            {
                "title": "Stagistic Editor",
                "width": 1280,
                "height": 800,
                "maximized": true
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
        "resources": {
            "icons/Assets.car": "Assets.car",
            "../../../packages/mcp/tauri-resources/": "mcp/"
        }
    }
}
