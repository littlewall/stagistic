{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Stagistic Desktop",
    "version": "0.1.0",
    "identifier": "com.stagistic.desktop",
    "build": {
        "beforeDevCommand": "pnpm dev:ui",
        "beforeBuildCommand": "pnpm build:ui",
        "devUrl": "http://localhost:5173",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "Stagistic Desktop",
                "width": 1280,
                "height": 800
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all"
    }
}
