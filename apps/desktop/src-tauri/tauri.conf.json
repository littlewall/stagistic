{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Stagistic Editor",
    "version": "0.1.0",
    "identifier": "com.stagistic.editor",
    "build": {
        "beforeDevCommand": "pnpm -w db:compile-migrations && pnpm dev:ui",
        "beforeBuildCommand": "pnpm -w db:compile-migrations && pnpm build:ui",
        "devUrl": "http://localhost:5173",
        "frontendDist": "../dist",
        "removeUnusedCommands": true
    },
    "app": {
        "windows": [
            {
                "title": "Stagistic Editor",
                "width": 1280,
                "height": 800,
                "maximized": true
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all"
    }
}
