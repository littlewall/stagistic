{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "allow-mcp-status",
    "allow-mcp-enable",
    "allow-mcp-disable",
    "allow-mcp-attach",
    "allow-mcp-detach",
    "allow-mcp-reply",
    "allow-mcp-prepare-manual",
    "allow-mcp-install-claude",
    "allow-desktop-shutdown-ready",
    "allow-desktop-exit",
    "allow-desktop-relaunch",
    "allow-desktop-show-backups-folder",
    "allow-desktop-show-attachments-folder",
    "allow-desktop-import-backup-file",
    "allow-desktop-open-download-page",
    "allow-desktop-open-external-url",
    "allow-desktop-open-licenses",
    "allow-desktop-set-menu-context",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:event:default",
    "core:event:allow-listen",
    "core:path:default",
    "core:path:allow-resolve-directory",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "dialog:default",
    "log:default",
    "updater:allow-check",
    "updater:allow-download-and-install",
    "fs:allow-appdata-read-recursive",
    "fs:allow-appdata-write-recursive",
    "fs:allow-write-file"
  ]
}
