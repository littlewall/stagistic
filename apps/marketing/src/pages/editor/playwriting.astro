---
import {clsx} from 'clsx';
import EditorLandingHero from '../../components/EditorLandingHero.astro';
import ScrollReveal from '../../components/ScrollReveal.astro';
import Layout from '../../layouts/Layout.astro';
import s from '../index.module.css';
---

<Layout
    title="Playwriting Software - Stagistic Editor"
    description="A professional playwriting software built for the stage. Format acts, scenes, stage directions, and multi-character dialogue effortlessly."
    canonical={new URL("/editor/playwriting", Astro.site).href}
    softwareApplication
    breadcrumbs={[
        {name: 'Stagistic', url: new URL('/', Astro.site).href.replace(/\/$/, '')},
        {name: 'Playwriting', url: new URL('/editor/playwriting', Astro.site).href},
    ]}
>
    <div class={s.page}>
        <EditorLandingHero
            title="Playwriting software built for the stage."
            description="Acts and scenes are not camera setups. Stagistic Editor keeps your play structured around characters, dialogue, and stage directions without making theatre conform to screenplay logic."
        />
        
        <section class={s.forTheatre}>
            <div class={clsx(s.forTheatreInner, s.reveal)} data-reveal>
                <div>
                    <h2 class={s.forTheatreTitle}>Acts and scenes, not INT. and EXT.</h2>
                </div>
                <div>
                    <p class={s.forTheatreText}>
                        Film tools assume a new location means a new scene. But on stage, a single act can span an hour in one room, or jump through time and space in minutes.
                    </p>
                    <p class={s.forTheatreText}>
                        Stagistic Editor is built on a true theatrical hierarchy. Group your scenes into acts, reorder them in the live outline, and let the editor handle the complex pagination and numbering automatically.
                    </p>
                    <p class={s.forTheatreText}>
                        Before a rewrite, save a numbered draft. For a reading, festival or tour, save a named version. You can revisit and export its saved writing, restore it, or continue it as a separate script.
                        <a href="https://docs.stagistic.com/editor/scripts/drafts-and-versions/">Learn how to save drafts and versions.</a>
                    </p>
                </div>
            </div>
        </section>

        <div class={s.sectionDivider} aria-hidden="true"></div>

        <section class={s.forTheatre}>
            <div class={clsx(s.forTheatreInner, s.reveal)} data-reveal>
                <div>
                    <h2 class={s.forTheatreTitle}>Characters with context.</h2>
                </div>
                <div>
                    <p class={s.forTheatreText}>
                        Theatre scripts demand flexibility that simple ALL CAPS text can't provide. In Stagistic Editor, characters are managed in a central catalogue.
                    </p>
                    <p class={s.forTheatreText}>
                        You can easily write dialogue for multiple characters speaking simultaneously. You can group characters into ensembles, assign alternate names (for disguises or character development), and even link multiple characters to a single actor for the final export.
                    </p>
                </div>
            </div>
        </section>

        <div class={s.sectionDivider} aria-hidden="true"></div>

        <section class={s.forTheatre}>
            <div class={clsx(s.forTheatreInner, s.reveal)} data-reveal>
                <div>
                    <h2 class={s.forTheatreTitle}>Smarter stage directions.</h2>
                </div>
                <div>
                    <p class={s.forTheatreText}>
                        Stage directions aren't just action lines. They are instructions for the director and the actors performing the scene.
                    </p>
                    <p class={s.forTheatreText}>
                        Stagistic Editor treats stage directions as distinct structural elements. You can write them inline within dialogue or as standalone blocks. Crucially, you can tag specific characters inside a stage direction, making it instantly clear who is performing the action.
                    </p>
                </div>
            </div>
        </section>

    </div>

    <ScrollReveal />
</Layout>
