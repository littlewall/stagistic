---
import {clsx} from 'clsx';
import CreatorNote from '../components/CreatorNote.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import SystemCta from '../components/SystemCta.astro';
import LandingMiniEditor from '../components/mini-editor/LandingMiniEditor';
import {landingFaqs} from '../data/landingFaqs';
import {landingFeatureGroups} from '../data/landingFeatures';
import Layout from '../layouts/Layout.astro';
import s from './index.module.css';
---

<Layout
    title="Stagistic Editor - Script editor for theatre and musicals"
    description="Stagistic Editor is a free script editor for theatre and musicals. No account, scripts stay on your computer, open source. Use it in your browser or download the Mac app."
    canonical={new URL('/', Astro.site).href.replace(/\/$/, '')}
    softwareApplication
>
    <div class={s.page}>
        <!-- Hero -->
        <section class={s.hero}>
            <div class={s.heroInner}>
                <div class={s.heroContent}>
                    <h1 class={clsx(s.heroTitle, s.fadeUp)}>A script editor for theatre and musicals.</h1>

                    <p class={clsx(s.heroDescription, s.fadeUp, s.fadeUpD1)}>
                        Write plays and musicals with acts, scenes, characters, dialogue, lyrics, and music cues. Not shots and cuts.
                    </p>

                    <div class={clsx(s.heroActions, s.fadeUp, s.fadeUpD2)}>
                        <SystemCta />
                        <p class={s.heroMeta}>Free forever · No account · Scripts stay on your computer · Open source</p>
                    </div>
                </div>

                <div class={clsx(s.heroScript, s.fadeUp, s.fadeUpD3)}>
                    <div class={s.tryEditorCallout} data-try-editor-callout>
                        <span class={s.visuallyHidden}>Try it!</span>
                        <svg viewBox="0 0 176 90" aria-hidden="true" focusable="false">
                            <path
                                class={clsx(s.tryEditorCalloutStroke, s.tryEditorCalloutText)}
                                pathLength="1"
                                vector-effect="non-scaling-stroke"
                                d="
                                        M8 17C19 13 31 12 43 14
                                        M25 13C22 22 20 32 19 42
                                        M38 25C37 31 37 36 37 41
                                        M38 29C43 23 49 23 52 27
                                        M55 26C56 34 59 39 63 38
                                        C68 37 71 30 73 25
                                        M73 25C71 38 69 49 63 55
                                        M91 26C90 31 89 36 89 41
                                        M93 17L92.5 17
                                        M102 20C100 28 99 34 99 40
                                        C99 43 101 44 104 41
                                        M95 27C101 26 107 26 111 27
                                        M121 18C119 26 118 33 117 38
                                        M116 45L116.5 45
                                    "
                            />
                            <path
                                class={clsx(s.tryEditorCalloutStroke, s.tryEditorCalloutArrow)}
                                pathLength="1"
                                vector-effect="non-scaling-stroke"
                                d="
                                        M132 27C158 28 170 38 166 52
                                        C162 66 142 73 120 70
                                        M120 70C126 66 131 61 134 57
                                        M120 70C127 72 132 76 136 80
                                    "
                            />
                        </svg>
                    </div>
                    <div
                        class={s.scriptExcerpt}
                        role="region"
                        aria-label="Interactive preview of Stagistic Editor"
                        aria-describedby="interactive-preview-description"
                    >
                        <LandingMiniEditor client:media="(min-width: 1000px)" />
                    </div>
                </div>
            </div>
        </section>

        <!-- For Theatre -->
        <section class={s.forTheatre}>
            <div class={clsx(s.forTheatreInner, s.reveal)} data-reveal>
                <div>
                    <h2 class={s.forTheatreTitle}>The screenplay problem.</h2>
                </div>
                <div>
                    <p class={s.forTheatreText}>
                        Tools like Final Draft are built for film. They assume camera setups, shots, and cuts, so writing a play in them means fighting the
                        formatting. Stagistic Editor is built around acts, scenes, music cues, and characters who speak together.
                    </p>
                </div>
            </div>
        </section>

        <div class={s.sectionDivider} data-section-divider aria-hidden="true"></div>

        <section class={s.features} id="features">
            <div class={clsx(s.featuresInner, s.reveal)} data-reveal>
                <h2 class={s.featuresTitle}>Everything a play or musical needs, in one place.</h2>
                {landingFeatureGroups.map(group => (
                    <div class={s.featureGroup}>
                        <h3 class={s.featureGroupTitle}>{group.title}</h3>
                        <div class={s.featuresList}>
                            {group.features.map(f => (
                                <article class={s.featureItem} data-text-only={f.videoSrc || f.imageSrc ? undefined : ''}>
                                    <div class={s.featureCopy}>
                                        <h4 class={s.featureLabel}>{f.label}</h4>
                                        <p class={s.featureDesc}>{f.description}</p>
                                        {f.href && (
                                            <div class={s.featureLinkWrap}>
                                                <a href={f.href} class={s.btnOutline}>
                                                    {f.linkLabel} &rarr;
                                                </a>
                                            </div>
                                        )}
                                    </div>
                                    {(f.videoSrc || f.imageSrc) && (
                                        <div class={s.featureMedia} data-feature-media data-shape={f.shape}>
                                            {f.videoSrc ? (
                                                <div class={s.featureMediaFrame}>
                                                    <video
                                                        data-feature-video
                                                        src={f.videoSrc}
                                                        title={f.videoTitle}
                                                        class={s.featureVideo}
                                                        data-fit={f.videoFit}
                                                        autoplay
                                                        muted
                                                        loop
                                                        playsinline
                                                    >
                                                        <source src={f.videoSrc} type="video/mp4" />
                                                    </video>
                                                </div>
                                            ) : (
                                                <div class={s.featureMediaFrame}>
                                                    <img
                                                        data-feature-image
                                                        src={f.imageSrc}
                                                        alt={f.imageAlt}
                                                        class={s.featureImage}
                                                        data-fit={f.imageFit}
                                                        loading="lazy"
                                                        decoding="async"
                                                    />
                                                </div>
                                            )}
                                        </div>
                                    )}
                                </article>
                            ))}
                        </div>
                    </div>
                ))}
            </div>
        </section>

        <div class={s.sectionDivider} data-section-divider aria-hidden="true"></div>

        <!-- FAQ -->
        <section class={s.faq} id="faq">
            <div class={clsx(s.faqInner, s.reveal)} data-reveal>
                <div>
                    <h2 class={s.faqTitle}>Common<br>questions.</h2>
                </div>
                <div class={s.faqList}>
                    {landingFaqs.map(faq => (
    <details class={s.faqItem}>
        <summary>
            <span>{faq.q}</span>
            <span class={s.faqIcon} aria-hidden="true">
                +
            </span>
        </summary>
        <p class={s.faqAnswer}>{faq.a}</p>
    </details>
))}
                </div>
            </div>
        </section>

        <CreatorNote />

        <!-- Free forever / CTA -->
        <section class={s.preview} id="preview">
            <div class={clsx(s.previewInner, s.reveal)} data-reveal>
                <div>
                    <h2 class={s.previewTitle}>Stagistic Editor is free.<br>Forever.</h2>
                    <p class={s.previewText}>
                        Stagistic Editor is free to use in your browser or on your Mac, with no account or paywall. Every current and future Editor feature will remain free.
                    </p>
                </div>
                <div class={s.previewCard}>
                    <div class={s.previewChecks}>
                        <div class={s.previewCheckItem}>
                            <span class={s.previewCheckMark}>
                                <svg viewBox="0 0 14 14" fill="none" aria-hidden="true" focusable="false">
                                    <path d="M3 7.5L5.5 10L11 4" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            </span>
                            <span>Free forever &amp; open source</span>
                        </div>
                        <div class={s.previewCheckItem}>
                            <span class={s.previewCheckMark}>
                                <svg viewBox="0 0 14 14" fill="none" aria-hidden="true" focusable="false">
                                    <path d="M3 7.5L5.5 10L11 4" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            </span>
                            <span>No account needed</span>
                        </div>
                        <div class={s.previewCheckItem}>
                            <span class={s.previewCheckMark}>
                                <svg viewBox="0 0 14 14" fill="none" aria-hidden="true" focusable="false">
                                    <path d="M3 7.5L5.5 10L11 4" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            </span>
                            <span>Scripts stay on your computer</span>
                        </div>
                    </div>
                    <div class={s.previewCtas}>
                        <SystemCta layout="stack" />
                    </div>
                </div>
            </div>
        </section>
    </div>

    <ScrollReveal />
</Layout>
