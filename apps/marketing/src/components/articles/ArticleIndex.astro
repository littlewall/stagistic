---
import type {CollectionEntry} from 'astro:content';
import ArticleMeta from './ArticleMeta.astro';

interface Props {
    articles: CollectionEntry<'articles'>[];
}

const {articles} = Astro.props;
---

<main class="articlesPage">
    <div class="articlesInner">
        <header class="intro">
            <h1>Articles</h1>
            <p>Practical notes on writing for the stage. From the first line of dialogue to the rehearsal room.</p>
        </header>

        {articles.length > 0 ? (
            <ul class="articleList">
                {articles.map(article => (
                    <li>
                        <article class="articleSummary">
                            <h2><a href={`/articles/${article.id}`}>{article.data.title}</a></h2>
                            <p class="description">{article.data.description}</p>
                            <ArticleMeta data={article.data} />
                        </article>
                    </li>
                ))}
            </ul>
        ) : (
            <section class="emptyState" aria-labelledby="articles-coming-soon">
                <h2 id="articles-coming-soon">The first articles are on their way.</h2>
                <p>We're working on pieces about playwriting, musical theatre, and preparing a script for the stage. Meanwhile, get to know the format behind Stagistic.</p>
                <a href="/editor/syntax">Explore the syntax <span aria-hidden="true">→</span></a>
            </section>
        )}
    </div>
</main>

<style>
.articlesPage {
    min-height: 65vh;
    padding: clamp(3rem, 8vw, 6rem) 1.5rem;
    background: var(--color-bg);
}

.articlesInner {
    max-width: 48rem;
    margin: 0 auto;
}

.intro {
    max-width: 38rem;
    margin-bottom: 3.5rem;
}

h1 {
    margin-bottom: 1rem;
    font-size: clamp(2.75rem, 7vw, 4.5rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.04em;
}

.intro p {
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--color-text-muted);
}

.articleList {
    list-style: none;
}

.articleSummary,
.emptyState {
    padding: 2rem 0;
    border-top: 1px solid var(--color-border);
}

h2 {
    margin-bottom: 0.75rem;
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.02em;
}

h2 a {
    color: inherit;
    text-decoration: none;
}

h2 a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
}

.description,
.emptyState p {
    max-width: 40rem;
    margin-bottom: 1rem;
    line-height: 1.75;
    color: var(--color-text-muted);
}

.emptyState > a {
    color: inherit;
    text-underline-offset: 0.25em;
}

a:focus-visible {
    border-radius: 0.125rem;
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 4px;
}

@media (max-width: 40em) {
    .articlesPage {
        padding-right: 1rem;
        padding-left: 1rem;
    }
}
</style>
