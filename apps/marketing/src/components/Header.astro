---
interface Props {
    variant?: 'full' | 'subpage';
}

const {variant = 'full'} = Astro.props;
// File-format builds include .html in Astro.url; public links omit it.
const currentPath = Astro.url.pathname.replace(/(?:\.html|\/)$/, '') || '/';
const navLinks = [
    {href: '/editor/playwriting', label: 'Playwriting'},
    {href: '/editor/musicals', label: 'Musicals'},
    {href: '/articles', label: 'Articles'},
    {href: 'https://docs.stagistic.com', label: 'Docs', external: true},
];
---

<header class="nav">
    <div class="navInner">
        <a href="/" class="navLogo">
            <img src="/assets/stagistic-brand/stagistic-mark-on-dark.svg" alt="" class="logoMark">
            <span class="logoText">Stagistic Editor</span>
        </a>

        {variant === 'full' && (
                <nav class="navLinks" aria-label="Primary">
                    {navLinks.map((link) => (
                        <a href={link.href} class="navLink" aria-current={currentPath === link.href ? 'page' : undefined}>
                            {link.label}
                            {link.external && <span aria-hidden="true">↗</span>}
                        </a>
                    ))}
                </nav>
            )}

        <a href="https://editor.stagistic.app" class="navCta">Try editor</a>
    </div>
</header>

<style>
.nav {
    --color-text: var(--color-stage-nav-text);
    --color-text-muted: var(--color-stage-text-muted);
    --color-border: var(--color-stage-border);

    position: sticky;
    z-index: 10;
    top: 0;
    color: var(--color-text);
    background: var(--color-stage-nav-bg);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
}

.navInner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: min(72rem, calc(100% - 3rem));
    height: 3rem;
    margin: 0 auto;
}

.navLogo {
    display: flex;
    gap: 0.5rem;
    align-items: flex-end;
    text-decoration: none;
}

.logoMark {
    display: block;
    width: auto;
    height: 1.625rem;
}

.logoText {
    padding: 0;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-text);
    letter-spacing: -0.01em;
}

.navLinks {
    display: flex;
    gap: 1.5rem;
    align-items: center;
}

.navLink {
    display: inline-flex;
    gap: 0.25rem;
    align-items: baseline;
    font-size: 0.8125rem;
    color: var(--color-text);
    text-decoration-color: transparent;
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3rem;
    transition: text-decoration-color 0.15s ease;

    &:hover,
    &[aria-current] {
        text-decoration-color: currentcolor;
    }

    &:focus-visible {
        color: var(--color-text);
        border-radius: 0.125rem;
        outline: 2px solid var(--color-focus-ring);
        outline-offset: 4px;
    }
}

.navCta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2rem;
    padding: 0.25rem 0.875rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-stage-btn-fg);
    text-decoration: none;
    background: var(--color-action);
    border: 1px solid transparent;
    border-radius: 9999px;
    transition:
        background 0.15s ease,
        transform 0.15s ease;

    &:hover {
        transform: translateY(-1px);
        background: var(--color-action-hover);
    }

    &:active {
        transform: translateY(0);
    }

    &:focus-visible {
        outline: 2px solid var(--color-focus-ring);
        outline-offset: 3px;
    }
}

@media (max-width: 62.4375em) {
    .navCta {
        display: none;
    }
}

@media (max-width: 40em) {
    .navInner {
        flex-wrap: wrap;
        gap: 0.75rem;
        width: calc(100% - 2rem);
        height: auto;
        padding: 0.75rem 0;
    }

    .navLinks {
        flex-wrap: wrap;
        gap: 0.5rem 1rem;
        width: 100%;
    }
}
</style>
