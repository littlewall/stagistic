---
import {getPublishedArticles} from '../data/articles';
import styles from './Header.module.css';
import HeaderEditorMenu from './HeaderEditorMenu.astro';

interface Props {
    variant?: 'full' | 'subpage';
}

const {variant = 'full'} = Astro.props;
// File-format builds include .html in Astro.url; public links omit it.
const currentPath = Astro.url.pathname.replace(/(?:\.html|\/)$/, '') || '/';
const hasPublishedArticles = variant === 'full' && (await getPublishedArticles()).length > 0;
---

<header class={styles.nav}>
    <div class={styles.navInner}>
        <a href="/" class={styles.navLogo}>
            <img src="/assets/stagistic-brand/stagistic-mark-on-dark.svg" alt="" class={styles.logoMark}>
            <span class={styles.logoText}>Stagistic Editor</span>
        </a>

        {variant === 'full' && (
                <nav class={styles.navLinks} aria-label="Primary">
                    <HeaderEditorMenu currentPath={currentPath} />
                    {hasPublishedArticles && (
                        <a href="/articles" class={styles.navLink} aria-current={currentPath === '/articles' ? 'page' : undefined}>
                            Articles
                        </a>
                    )}
                    <a href="https://docs.stagistic.com" class={styles.navLink}>
                        Docs <span aria-hidden="true">↗</span>
                    </a>
                </nav>
            )}

        <a href="https://editor.stagistic.app" class={styles.navCta}>Try editor</a>
    </div>
</header>
