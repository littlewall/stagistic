---
import {clsx} from 'clsx';
import {DOWNLOAD_PATH, WEB_APP_URL} from '../data/site';
import s from '../pages/index.module.css';

interface Props {
    title: string;
    description: string;
}

const {title, description} = Astro.props;
---

<section class={s.hero}>
    <div class={s.heroInner}>
        <div class={s.heroContent}>
            <h1 class={clsx(s.heroTitle, s.fadeUp)}>{title}</h1>
            <p class={clsx(s.heroDescription, s.fadeUp, s.fadeUpD1)}>{description}</p>
            <div class={clsx(s.heroCtas, s.fadeUp, s.fadeUpD2)}>
                <a href={DOWNLOAD_PATH} class={s.btnPrimary}>Download</a>
                <a href={WEB_APP_URL} class={s.btnOutline}>Try in browser</a>
            </div>
        </div>
    </div>
</section>
