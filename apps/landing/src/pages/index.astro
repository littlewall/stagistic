---
import {clsx} from 'clsx';
import '../styles/global.css';
import s from './index.module.css';

const features = [
    {
        label: 'Theatre-native writing',
        description:
            'Dedicated blocks for acts, scene headings, character cues, dialogue, stage directions, lyrics, and notes. Every part of the script keeps its own formatting and behaviour.',
    },
    {
        label: 'Acts and scenes that stay connected',
        description:
            'A live outline keeps the structure visible as you write. Jump directly to any scene, reorder scenes, and group them into acts instead of forcing your play into a screenplay-shaped structure.',
    },
    {
        label: 'Characters throughout the script',
        description:
            'Build a character catalogue directly from your script. Assign colours, highlight appearances across the document, rename characters consistently, and tag them inside stage directions.',
    },
    {
        label: 'Ready for musicals',
        description:
            'Write lyrics as their own block type, manage songs and instrumentals, place music cues and out markers directly in the script, and attach score PDFs to individual musical numbers.',
    },
    {
        label: 'A writing flow you can configure',
        description:
            'Configure page format, title page, headers and footers, and each block\'s indentation, alignment, emphasis, and casing. Set keyboard shortcuts and decide which block follows next, so the editor matches the way you write.',
    },
    {
        label: 'Advanced PDF export',
        description:
            'Preview and export professionally formatted PDFs, start scenes on new or odd-numbered pages, generate character-specific versions, or create an integrated-score export with the corresponding sheet music inserted at the right points.',
    },
];

const faqs = [
    {
        q: 'Is Stagistic Editor free?',
        a: 'Yes. Stagistic Editor is free now and will remain free in the future. There is no subscription, trial, or paywall for writing, structuring, or exporting your scripts.',
    },
    {
        q: 'Do I need an account?',
        a: 'No. You can open the editor and start writing without signing up. Your scripts are stored locally in your browser by default. You can also download a backup of your work and import it again whenever you need it.',
    },
    {
        q: 'Is this really built for theatre?',
        a: 'Yes! Acts, scenes, stage directions, character cues, lyrics, and music are part of the document model rather than formatting conventions layered onto a screenplay editor.',
    },
    {
        q: 'Does it work for both plays and musicals?',
        a: 'Yes. Plays get theatre-specific structure, characters, stage directions, and flexible export. Musicals add dedicated lyric blocks, music cues and outs, song and instrumental catalogues, score PDFs, and integrated-score export.',
    },
    {
        q: 'Where is my data stored?',
        a: 'Locally in your browser. You can download a .stagistic backup and import it again whenever you need it. Cloud sync is not ready yet; but when it is, it will be free.',
    },
    {
        q: 'Can I use it for a commercial production?',
        a: 'Absolutely! There are no restrictions on how you use scripts you write in Stagistic. The editor is free for everyone.',
    },
    {
        q: 'Is Stagistic Editor open source?',
        a: 'Yes, the editor is available on GitHub under the MIT licence. Any contributions are welcome!',
    },
    {
        q: 'What platforms does it run on?',
        a: 'The editor runs in any modern browser without installation. Desktop and mobile apps are planned in future.',
    },
    {
        q: 'Is this stable enough to use for real work?',
        a: "It's an experimental release. The core writing experience is functional, but expect rough edges. We recommend keeping backups of important scripts. Feedback and bug reports are very welcome - they directly shape what gets fixed first.",
    },
];
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>Stagistic — The editor built for theatre</title>
        <meta
            name="description"
            content="Stagistic is a script editor built specifically for theatrical plays and musicals. Not screenwriting. Not prose. The stage."
        />
        <meta property="og:image" content="/opengraph.jpg" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Courier+Prime:ital,wght@0,400;0,700;1,400&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
            rel="stylesheet"
        />
        <script is:inline>document.documentElement.classList.add('js');</script>
    </head>
    <body>
        <div class={s.page}>

            <!-- Nav -->
            <header class={s.nav}>
                <div class={s.navInner}>
                    <div class={s.navLogo}>
                        <span class={s.logoText}>Stagistic</span>
                        <span class={s.logoBadge}>Editor</span>
                    </div>
                    <nav class={s.navLinks}>
                        <a href="#features" class={s.navLink}>Features</a>
                        <a href="#faq" class={s.navLink}>FAQ</a>
                        <a href="#alpha" class={s.navLink}>Get started</a>
                    </nav>
                    <span class={s.navBadge}>Early alpha</span>
                </div>
            </header>

            <!-- Hero -->
            <section class={s.hero}>
                <div class={s.heroInner}>

                    <div class={s.heroContent}>
                        <h1 class={clsx(s.heroTitle, s.fadeUp)}>
                            The editor built for theatre.
                        </h1>

                        <p class={clsx(s.heroDescription, s.fadeUp, s.fadeUpD1)}>
                            Stagistic is a script editor built specifically for
                            theatrical plays and musicals. Not screenwriting. Not
                            prose. The stage.
                        </p>

                        <div class={clsx(s.heroCtas, s.fadeUp, s.fadeUpD2)}>
                            <a href="https://editor.stagistic.app" class={s.btnPrimary}>
                                Open editor in browser
                            </a>
                        </div>
                    </div>

                    <div class={clsx(s.heroScript, s.fadeUp, s.fadeUpD3)}>
                        <div class={s.scriptExcerpt}>
                            <div class={s.scriptExcerptBar}>
                                <span>Act Two — Scene One</span>
                                <span>stagistic editor</span>
                            </div>
                            <div class={s.scriptBody}>
                                <p class={s.sAct}>ACT TWO, SCENE ONE</p>

                                <p class={s.sDir}>
                                    An empty rehearsal room. Piano, lid open.
                                    MARA stands at the window. JONAS enters.
                                </p>

                                <p class={s.sChar}>JONAS</p>
                                <div class={s.sSpeech}>
                                    <p>I know you're not ready.</p>
                                </div>

                                <p class={s.sDir}>MARA doesn't turn around.</p>

                                <p class={s.sChar}>MARA</p>
                                <div class={s.sSpeech}>
                                    <p>I'm always ready.</p>
                                    <p class={s.sParen}>(a beat)</p>
                                    <p>That's the problem.</p>
                                </div>

                                <p class={s.sChar}>JONAS</p>
                                <div class={s.sSpeech}>
                                    <p>The director wants the number</p>
                                    <p>from the top of Act One.</p>
                                </div>

                                <p class={s.sMusic}>
                                    Musical number: FIRST LIGHT (reprise, bar 23)
                                </p>
                            </div>
                        </div>
                    </div>

                </div>
            </section>

            <!-- For Theatre -->
            <section class={s.forTheatre}>
                <div class={clsx(s.forTheatreInner, s.reveal)} data-reveal>
                    <div>
                        <h2 class={s.forTheatreTitle}>
                            Every decision made<br />for stage writing.
                        </h2>
                    </div>
                    <div>
                        <p class={s.forTheatreText}>
                            Stagistic understands the craft of theatre: how a scene builds, how a musical number interrupts and transforms dialogue, how stage directions serve the director as much as the story. These aren't formatting rules. They're how theatre thinks.
                        </p>
                        <p class={s.forTheatreText}>
                            Whether you're writing a one-act play or a full two-act musical, the editor stays out of your way and keeps your work structured exactly as theatre demands.
                        </p>
                    </div>
                </div>
            </section>

            <!-- Features -->
            <section class={s.features} id="features">
                <div class={clsx(s.featuresInner, s.reveal)} data-reveal>
                    <h2 class={s.featuresTitle}>What's included.</h2>
                    <div class={s.featuresList}>
                        {
                            features.map((f) => (
                                <div class={s.featureItem}>
                                    <span class={s.featureLabel}>{f.label}</span>
                                    <p class={s.featureDesc}>{f.description}</p>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </section>

            <!-- FAQ -->
            <section class={s.faq} id="faq">
                <div class={clsx(s.faqInner, s.reveal)} data-reveal>
                    <div>
                        <h2 class={s.faqTitle}>Common<br />questions.</h2>
                    </div>
                    <div class={s.faqList}>
                        {
                            faqs.map((faq) => (
                                <details class={s.faqItem}>
                                    <summary>
                                        <span>{faq.q}</span>
                                        <span class={s.faqIcon} aria-hidden="true">+</span>
                                    </summary>
                                    <p class={s.faqAnswer}>{faq.a}</p>
                                </details>
                            ))
                        }
                    </div>
                </div>
            </section>

            <!-- Alpha / CTA -->
            <section class={s.alpha} id="alpha">
                <div class={clsx(s.alphaInner, s.reveal)} data-reveal>
                    <div>
                        <h2 class={s.alphaTitle}>
                            Stagistic Editor is free.<br />Forever.
                        </h2>
                        <p class={s.alphaText}>
                            Writing in Stagistic is free in your browser, with
                            no account or paywall. The editor will remain free.
                        </p>
                        <p class={s.alphaTextSecondary}>
                            There may be some product features in future that require a paid subscription, but the core writing experience will always be free and open source.
                        </p>
                    </div>
                    <div class={s.alphaCard}>
                        <div class={s.alphaChecks}>
                            <div class={s.alphaCheckItem}>
                                <span class={s.alphaCheckMark}>✓</span>
                                <span>Free &amp; open source</span>
                            </div>
                            <div class={s.alphaCheckItem}>
                                <span class={s.alphaCheckMark}>✓</span>
                                <span>No account needed</span>
                            </div>
                            <div class={s.alphaCheckItem}>
                                <span class={s.alphaCheckMark}>✓</span>
                                <span>Stored locally by default</span>
                            </div>
                        </div>
                        <div class={s.alphaCtas}>
                            <a href="https://editor.stagistic.app" class={s.btnPrimary}>
                                Open editor in browser
                            </a>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Footer -->
            <footer class={s.footer}>
                <div class={s.footerInner}>
                    <div class={s.footerLeft}>
                        <span class={s.footerLogo}>Stagistic</span>
                        <span class={s.footerTagline}>Building tools for theatre.</span>
                    </div>
                    <div class={s.footerRight}>
                        <a href="/syntax" class={s.footerLink}>Syntax</a>
                        <a
                            href="https://github.com/littlewall/stagistic"
                            class={s.footerLink}
                        >
                            GitHub repo
                        </a>
                        <a href="mailto:hello@stagistic.com" class={s.footerLink}>
                            hello@stagistic.com
                        </a>
                    </div>
                </div>
            </footer>

        </div>

        <script>
            const observer = new IntersectionObserver(
                (entries) => {
                    for (const entry of entries) {
                        if (entry.isIntersecting) {
                            entry.target.setAttribute('data-visible', '');
                            observer.unobserve(entry.target);
                        }
                    }
                },
                {threshold: 0.06, rootMargin: '-20px'},
            );

            document.querySelectorAll('[data-reveal]').forEach((el) => {
                observer.observe(el);
            });
        </script>
    </body>
</html>
