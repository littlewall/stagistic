---
import {clsx} from 'clsx';
import LandingMiniEditor from '../components/mini-editor/LandingMiniEditor';
import Layout from '../layouts/Layout.astro';
import s from './index.module.css';

const features = [
    {
        label: 'A playwriting structure',
        description:
            'Dedicated blocks for acts, scene headings, character cues, dialogue, stage directions, lyrics, and notes. Every part of the script keeps its own formatting and behaviour.',
        videoSrc: '/features/theatre-writing.mp4',
        videoTitle: 'A formatted theatre script in Stagistic Editor',
        videoFit: 'contain',
        shape: 'one',
        href: '/editor/playwriting',
        linkLabel: 'Explore stage playwriting',
    },
    {
        label: 'Acts and scenes that stay connected',
        description:
            'A live outline keeps the structure visible as you write. Jump directly to any scene, reorder scenes, and group them into acts instead of forcing your play into a screenplay-shaped structure.',
        videoSrc: '/features/acts-and-scenes.mp4',
        videoTitle: 'The scene outline beside a script in Stagistic Editor',
        videoFit: 'contain',
        shape: 'two',
        href: '/editor/syntax',
        linkLabel: 'Read the Stagistic syntax reference',
    },
    {
        label: 'Smart character management',
        description:
            'Build a character catalogue directly from your script. Assign colours, highlight appearances, group characters, rename characters, tag them inside stage directions, and write dialogue for two or more characters speaking together.',
        imageSrc: '/features/characters.png',
        imageAlt: 'The character catalogue in Stagistic Editor',
        imageFit: 'contain',
        shape: 'three',
    },
    {
        label: 'First-class musical theatre support',
        description:
            'Write lyrics as their own block type, manage songs and instrumentals, place music cues directly in the script, and attach score PDFs to individual musical numbers.',
        imageSrc: '/features/musical.png',
        imageAlt: 'Lyrics formatted inside a musical script in Stagistic Editor',
        imageFit: 'contain',
        shape: 'one',
        href: '/editor/musicals',
        linkLabel: 'Explore musical theatre writing',
    },
    {
        label: 'A writing flow you can configure',
        description:
            "Configure page format, title page, headers and footers, and each block's indentation, alignment, emphasis, and casing. Set keyboard shortcuts and decide which block follows next, so the editor matches the way you write.",
        imageSrc: '/features/writing-flow.png',
        imageAlt: 'Formatting controls above a script in Stagistic Editor',
        imageFit: 'cover',
        shape: 'three',
    },
    {
        label: 'Integrated script and score export',
        description:
            'Export your script and sheet music into a single, print-ready PDF. Stagistic Editor automatically handles page numbering across your text and inserted music scores, so actors and musicians always stay on the same page.',
        imageSrc: '/features/export.png',
        imageAlt: 'A print-ready theatre script displayed in Stagistic Editor',
        imageFit: 'cover',
        shape: 'two',
    },
];

const faqs = [
    {
        q: 'Is Stagistic Editor free?',
        a: 'Yes. Stagistic Editor is free now and will remain free in the future. There is no subscription, trial, or paywall for writing, structuring, or exporting your scripts.',
    },
    {
        q: 'Do I need an account?',
        a: 'No. You can open the editor and start writing without signing up. Your scripts are stored locally in your browser by default. You can also download a backup of your work and import it again whenever you need it.',
    },
    {
        q: 'Where is my data stored?',
        a: 'Locally in your browser. You can download a .stagistic backup and import it again whenever you need it. Cloud sync is not ready yet; but when it is, it will be free.',
    },
    {
        q: 'Can I use it for a commercial production?',
        a: 'Absolutely! There are no restrictions on how you use scripts you write in Stagistic Editor. The editor is free for everyone.',
    },
    {
        q: 'How is Stagistic Editor different from other software?',
        a: 'Industry standard tools like Final Draft use a screenplay structure (INT/EXT) which Stagistic Editor deliberately avoids in favour of theatre acts and scenes. It is designed from the ground up specifically for stage plays and musicals.',
    },
    {
        q: 'How does Stagistic Editor help me format a stage script?',
        a: 'Instead of formatting text with spaces and tabs, Stagistic Editor uses dedicated blocks for elements like stage directions, dialogue, and lyrics. This means your play stays perfectly structured, character names remain linked to a central cast list, and stage directions format automatically.',
    },
    {
        q: 'How do I format a musical script?',
        a: 'Writing a libretto is natively supported. Stagistic Editor has dedicated blocks for lyrics, handles songs and instrumentals via a catalogue, and allows you to attach PDF scores directly to musical numbers. The export engine then seamlessly combines your script and scores into one paginated document.',
    },
    {
        q: 'Is Stagistic Editor open source?',
        a: 'Yes, the editor is available on GitHub under the MIT licence. Any contributions are welcome!',
    },
];
---

<Layout
    title="Stagistic Editor - Script editor built for theatre"
    description="Stagistic Editor is a script editor built specifically for theatrical plays and musicals. Not screenwriting. Not prose. The stage."
    canonical={new URL("/", Astro.site).href.replace(/\/$/, '')}
    softwareApplication
>
    <div class={s.page}>
        <!-- Hero -->
        <section class={s.hero}>
            <div class={s.heroInner}>
                <div class={s.heroContent}>
                    <h1 class={clsx(s.heroTitle, s.fadeUp)}>Write for the stage, not the screen.</h1>

                    <p class={clsx(s.heroDescription, s.fadeUp, s.fadeUpD1)}>
                        Your play is not a screenplay with the camera removed. Stagistic Editor is a free, browser-based script editor built for acts, scenes,
                        dialogue, lyrics, and music cues. Not shots and cuts.
                    </p>

                    <div class={clsx(s.heroCtas, s.fadeUp, s.fadeUpD2)}>
                        <a href="https://editor.stagistic.app" class={s.btnPrimary}> Open editor in browser </a>
                        <a href="#features" class={s.btnOutline}> Explore features </a>
                    </div>
                </div>

                <div class={clsx(s.heroScript, s.fadeUp, s.fadeUpD3)}>
                    <div class={s.tryEditorCallout} data-try-editor-callout>
                        <span class={s.visuallyHidden}>Try it!</span>
                        <svg viewBox="0 0 176 90" aria-hidden="true" focusable="false">
                            <path
                                class={clsx(
                                        s.tryEditorCalloutStroke,
                                        s.tryEditorCalloutText,
                                    )}
                                pathLength="1"
                                vector-effect="non-scaling-stroke"
                                d="
                                        M8 17C19 13 31 12 43 14
                                        M25 13C22 22 20 32 19 42
                                        M38 25C37 31 37 36 37 41
                                        M38 29C43 23 49 23 52 27
                                        M55 26C56 34 59 39 63 38
                                        C68 37 71 30 73 25
                                        M73 25C71 38 69 49 63 55
                                        M91 26C90 31 89 36 89 41
                                        M93 17L92.5 17
                                        M102 20C100 28 99 34 99 40
                                        C99 43 101 44 104 41
                                        M95 27C101 26 107 26 111 27
                                        M121 18C119 26 118 33 117 38
                                        M116 45L116.5 45
                                    "
                            />
                            <path
                                class={clsx(
                                        s.tryEditorCalloutStroke,
                                        s.tryEditorCalloutArrow,
                                    )}
                                pathLength="1"
                                vector-effect="non-scaling-stroke"
                                d="
                                        M132 27C158 28 170 38 166 52
                                        C162 66 142 73 120 70
                                        M120 70C126 66 131 61 134 57
                                        M120 70C127 72 132 76 136 80
                                    "
                            />
                        </svg>
                    </div>
                    <div class={s.scriptExcerpt} aria-describedby="interactive-preview-description">
                        <LandingMiniEditor client:media="not (max-width: 1000px)" />
                    </div>
                    <p class={s.desktopOnlyNotice} role="note">
                        Stagistic Editor is built for larger screens. Open it on a laptop or desktop at least 1000 pixels wide &mdash; mobile support is on the
                        way.
                    </p>
                </div>
            </div>
        </section>

        <!-- For Theatre -->
        <section class={s.forTheatre}>
            <div class={clsx(s.forTheatreInner, s.reveal)} data-reveal>
                <div>
                    <h2 class={s.forTheatreTitle}>The screenplay problem.</h2>
                </div>
                <div>
                    <p class={s.forTheatreText}>
                        Industry standard tools like Final Draft are built for film. They assume your story is driven by <em>INT/EXT</em> camera setups, shots,
                        and cuts. When you try to write a play in them, you spend more time fighting the formatting than writing.
                    </p>
                    <p class={s.forTheatreText}>
                        Stagistic Editor is different. It understands the craft of theatre: acts, scenes, musical cues, and complex character interactions. It
                        doesn't force a screenplay structure onto your stage play.
                    </p>
                </div>
            </div>
        </section>

        <div class={s.sectionDivider} data-section-divider aria-hidden="true"></div>

        <section class={s.features} id="features">
            <div class={clsx(s.featuresInner, s.reveal)} data-reveal>
                <h2 class={s.featuresTitle}>Features built for playwrights and librettists.</h2>
                <div class={s.featuresList}>
                    {features.map((f) => (
                                <article class={s.featureItem}>
                                    <div class={s.featureCopy}>
                                        <h3 class={s.featureLabel}>{f.label}</h3>
                                        <p class={s.featureDesc}>{f.description}</p>
                                        {f.href && (
                                            <div class={s.featureLinkWrap}>
                                                <a href={f.href} class={s.btnOutline}>
                                                    {f.linkLabel} &rarr;
                                                </a>
                                            </div>
                                        )}
                                    </div>
                                    <div
                                        class={s.featureMedia}
                                        data-feature-media
                                        data-shape={f.shape}
                                    >
                                        { f.videoSrc ? (
                                            <div class={s.featureMediaFrame}>
                                                <video
                                                    data-feature-video
                                                    src={f.videoSrc}
                                                    title={f.videoTitle}
                                                    class={s.featureVideo}
                                                    data-fit={f.videoFit}
                                                    autoplay
                                                    muted
                                                    loop
                                                    playsinline
                                                >
                                                    <source src={f.videoSrc} type="video/mp4" />
                                                </video>
                                            </div>
                                        ) : f.imageSrc ? (
                                            <div class={s.featureMediaFrame}>
                                                <img
                                                    data-feature-image
                                                    src={f.imageSrc}
                                                    alt={f.imageAlt}
                                                    class={s.featureImage}
                                                    data-fit={f.imageFit}
                                                    loading="lazy"
                                                    decoding="async"
                                                />
                                            </div>
                                        ) : null }
                                    </div>
                                </article>
                            ))}
                </div>
            </div>
        </section>

        <div class={s.sectionDivider} data-section-divider aria-hidden="true"></div>

        <!-- FAQ -->
        <section class={s.faq} id="faq">
            <div class={clsx(s.faqInner, s.reveal)} data-reveal>
                <div>
                    <h2 class={s.faqTitle}>Common<br>questions.</h2>
                </div>
                <div class={s.faqList}>
                    {faqs.map((faq) => (
                                <details class={s.faqItem}>
                                    <summary>
                                        <span>{faq.q}</span>
                                        <span class={s.faqIcon} aria-hidden="true">+</span>
                                    </summary>
                                    <p class={s.faqAnswer}>{faq.a}</p>
                                </details>
                            ))}
                </div>
            </div>
        </section>

        <!-- Public preview / CTA -->
        <section class={s.preview} id="preview">
            <div class={clsx(s.previewInner, s.reveal)} data-reveal>
                <div>
                    <h2 class={s.previewTitle}>Stagistic Editor is free.<br>Forever.</h2>
                    <p class={s.previewText}>
                        Stagistic Editor is free to use in your browser, with no account or paywall. Every current and future Editor feature will remain free.
                    </p>
                </div>
                <div class={s.previewCard}>
                    <div class={s.previewChecks}>
                        <div class={s.previewCheckItem}>
                            <span class={s.previewCheckMark}>
                                <svg viewBox="0 0 14 14" fill="none" aria-hidden="true" focusable="false">
                                    <path d="M3 7.5L5.5 10L11 4" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            </span>
                            <span>Free &amp; open source</span>
                        </div>
                        <div class={s.previewCheckItem}>
                            <span class={s.previewCheckMark}>
                                <svg viewBox="0 0 14 14" fill="none" aria-hidden="true" focusable="false">
                                    <path d="M3 7.5L5.5 10L11 4" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            </span>
                            <span>No account needed</span>
                        </div>
                        <div class={s.previewCheckItem}>
                            <span class={s.previewCheckMark}>
                                <svg viewBox="0 0 14 14" fill="none" aria-hidden="true" focusable="false">
                                    <path d="M3 7.5L5.5 10L11 4" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            </span>
                            <span>Stored locally by default</span>
                        </div>
                    </div>
                    <div class={s.previewCtas}>
                        <a href="https://editor.stagistic.app" class={s.btnPrimary}> Open editor in browser </a>
                        <p class={s.desktopOnlyNotice} role="note">
                            Stagistic Editor is built for larger screens. Open it on a laptop or desktop at least 1000 pixels wide &mdash; mobile support is on
                            the way.
                        </p>
                    </div>
                </div>
            </div>
        </section>
    </div>

    <script>
    const observer = new IntersectionObserver(
        entries => {
            for (const entry of entries) {
                if (entry.isIntersecting) {
                    entry.target.setAttribute('data-visible', '');
                    observer.unobserve(entry.target);
                }
            }
        },
        {threshold: 0.06, rootMargin: '-20px'},
    );

    document.querySelectorAll('[data-reveal]').forEach(el => {
        observer.observe(el);
    });
    </script>
</Layout>
