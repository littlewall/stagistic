---
import Layout from '../../layouts/Layout.astro';
import SyntaxBasicsSections from '../../components/syntax-guide/SyntaxBasicsSections.astro';
import SyntaxMarkupSections from '../../components/syntax-guide/SyntaxMarkupSections.astro';
import SyntaxSpeechSections from '../../components/syntax-guide/SyntaxSpeechSections.astro';
import SyntaxTocList from '../../components/syntax-guide/SyntaxTocList.astro';
import s from './syntax.module.css';
---

<Layout
    title="Stagistic Syntax Reference - Stagistic Editor"
    description="Learn the Stagistic syntax: an open, plain-text format designed specifically for theatre and musical scripts. No proprietary lock-in."
    canonical={new URL("/editor/syntax", Astro.site).href}
    softwareApplication
    breadcrumbs={[
        {name: 'Stagistic', url: new URL('/', Astro.site).href.replace(/\/$/, '')},
        {name: 'Syntax', url: new URL('/editor/syntax', Astro.site).href},
    ]}
>
    <div class={s.page}>
        <main class={s.main}>
            <div class={s.shell}>
                <!-- Table of contents -->
                <aside class={s.toc}>
                    <p class={s.tocTitle}>On this page</p>
                    <SyntaxTocList class={s.tocList} />
                </aside>

                <!-- Content -->
                <div class={s.content}>
                    <details class={s.narrowToc}>
                        <summary class={s.narrowTocSummary}>On this page</summary>
                        <nav aria-label="On this page">
                            <SyntaxTocList class={s.narrowTocList} />
                        </nav>
                    </details>

                    <header class={s.lede}>
                        <p class={s.eyebrow}>The format</p>
                        <h1 class={s.docTitle}>Stagistic syntax</h1>
                        <p class={s.docIntro}>
                            Stagistic Syntax is an open, plain-text format for theatrical plays and musicals. It supports acts, scenes, character cues, dialogue,
                            stage directions, lyrics, and music cues while keeping most writing free of markup.
                        </p>
                        <p class={s.docIntroSecondary}>
                            Formats such as <a href="https://fountain.io" target="_blank" class={s.textLink}>Fountain</a> are designed primarily for
                            screenwriting. Stagistic Syntax brings the same plain-text simplicity to theatre, making syntax explicit only where the meaning would
                            otherwise be ambiguous.
                        </p>
                    </header>

                    <SyntaxBasicsSections />

                    <SyntaxSpeechSections />

                    <SyntaxMarkupSections />
                </div>
            </div>
        </main>
    </div>
</Layout>
