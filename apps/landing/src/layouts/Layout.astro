---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SiteIcons from '../components/SiteIcons.astro';
import StructuredData from '../components/StructuredData.astro';
import '../styles/global.css';

interface Props {
    title: string;
    description: string;
    canonical?: string;
    header?: 'full' | 'subpage';
    softwareApplication?: boolean;
    breadcrumbs?: Array<{
        name: string;
        url: string;
    }>;
}

const {title, description, canonical, header = 'full', softwareApplication, breadcrumbs} = Astro.props;
const pageUrl = canonical || new URL(Astro.url.pathname, Astro.site).href;
---

<html lang="en">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <SiteIcons />
        <title>{title}</title>
        <meta name="description" content={description}>
        {canonical && <link rel="canonical" href={canonical} />}
        <StructuredData canonical={pageUrl} description={description} softwareApplication={softwareApplication} breadcrumbs={breadcrumbs} />

        <meta property="og:title" content={title}>
        <meta property="og:description" content={description}>
        <meta property="og:type" content="website">
        <meta property="og:url" content={pageUrl}>
        <meta property="og:image" content={new URL('/opengraph.jpg', Astro.site).href}>
        <meta property="og:image:alt" content="Stagistic Editor preview">
        <meta property="og:image:width" content="1200">
        <meta property="og:image:height" content="630">
        <meta property="og:image:type" content="image/jpeg">
        <meta property="og:site_name" content="Stagistic">
        <meta name="twitter:card" content="summary_large_image">
        <script is:inline>
        document.documentElement.classList.add('js');
        </script>
    </head>
    <body>
        <Header variant={header} />
        <slot />
        <Footer />
    </body>
</html>
