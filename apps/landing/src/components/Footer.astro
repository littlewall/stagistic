---
const footerColumns = [
    {
        title: 'Editor',
        links: [
            {href: '/', label: 'Overview'},
            {href: '/editor/playwriting', label: 'For Playwriting'},
            {href: '/editor/musicals', label: 'For Musicals'},
            {href: '/editor/syntax', label: 'Syntax Reference'},
        ],
    },
    {
        title: 'Project',
        links: [
            {href: '/open-source', label: 'Open Source & Manifesto'},
            {href: 'https://github.com/littlewall/stagistic', label: 'GitHub repo', target: '_blank', rel: 'noopener noreferrer'},
            {href: 'https://feedback.stagistic.com', label: 'Feedback & bug reports', target: '_blank', rel: 'noopener noreferrer'},
        ],
    },
];
---

<footer class="footer">
    <div class="footerInner">
        <div class="footerLeft">
            <span class="footerLogo">© Stagistic • Made with 💛 in Prague</span>
        </div>
        <div class="footerRight">
            {footerColumns.map((col) => (
                    <div class="footerCol">
                        <h3 class="footerColTitle">{col.title}</h3>
                        <ul class="footerColLinks">
                            {col.links.map((link) => (
                                <li>
                                    <a href={link.href} class="footerLink" target={link.target} rel={link.rel}>
                                        {link.label}
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </div>
                ))}
        </div>
    </div>
</footer>

<style>
.footer {
    --color-text: var(--color-stage-nav-text);
    --color-text-muted: var(--color-stage-text-muted);
    --color-border: var(--color-stage-border);

    padding: 2.75rem 1.5rem;
    color: var(--color-text);
    background: var(--color-stage-bg);
    border-top: 1px solid var(--color-border);
}

.footerInner {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    align-items: flex-start;
    justify-content: space-between;
    max-width: 72rem;
    margin: 0 auto;
}

.footerLeft {
    display: flex;
    align-items: flex-start;
}

.footerLogo {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--color-text-muted);
}

.footerRight {
    display: flex;
    flex-wrap: wrap;
    gap: 3rem;
    align-items: flex-start;
}

.footerCol {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
}

.footerColTitle {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin: 0;
}

.footerColLinks {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
}

.footerLink {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.15s ease;

    &:hover {
        color: var(--color-text);
    }

    &:focus-visible {
        color: var(--color-text);
        border-radius: 0.125rem;
        outline: 2px solid var(--color-focus-ring);
        outline-offset: 4px;
    }
}

@media (max-width: 640px) {
    .footer {
        padding-right: 1rem;
        padding-left: 1rem;
    }

    .footerInner {
        flex-direction: column;
        align-items: flex-start;
    }
}
</style>
