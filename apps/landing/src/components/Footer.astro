---
const footerLinks = [
    {href: '/', label: 'Home'},
    {href: '/syntax', label: 'Syntax'},
    {
        href: 'https://github.com/littlewall/stagistic',
        label: 'GitHub repo',
    },
    {
        href: 'https://stagistic.userjot.com',
        label: 'Feedback & bug reports',
    },
];
---

<footer class="footer">
    <div class="footerInner">
        <div class="footerLeft">
            <span class="footerLogo">© Stagistic • Made with 💛 in Prague</span>
        </div>
        <div class="footerRight">
            {
                footerLinks.map((link) => (
                    <a href={link.href} class="footerLink">
                        {link.label}
                    </a>
                ))
            }
        </div>
    </div>
</footer>

<style>
    .footer {
        --color-text: var(--color-stage-nav-text);
        --color-text-muted: var(--color-stage-text-muted);
        --color-border: var(--color-stage-border);

        padding: 2.75rem 1.5rem;
        color: var(--color-text);
        background: var(--color-stage-bg);
        border-top: 1px solid var(--color-border);
    }

    .footerInner {
        display: flex;
        flex-wrap: wrap;
        gap: 1.5rem;
        align-items: center;
        justify-content: space-between;
        max-width: 72rem;
        margin: 0 auto;
    }

    .footerLeft {
        display: flex;
        align-items: center;
    }

    .footerLogo {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        font-weight: 400;
        color: var(--color-text-muted);
    }

    .footerRight {
        display: flex;
        flex-wrap: wrap;
        gap: 1.5rem;
        align-items: center;
    }

    .footerLink {
        font-size: 0.8125rem;
        color: var(--color-text-muted);
        text-decoration: none;
        transition: color 0.15s ease;

        &:hover {
            color: var(--color-text);
        }

        &:focus-visible {
            color: var(--color-text);
            border-radius: 0.125rem;
            outline: 2px solid var(--color-blue);
            outline-offset: 4px;
        }
    }

    @media (max-width: 640px) {
        .footer {
            padding-right: 1rem;
            padding-left: 1rem;
        }

        .footerInner {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>
