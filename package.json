{
    "name": "stagistic",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Cloud editor for theatre and musical scripts",
    "license": "MIT",
    "author": "Stagistic Team",
    "engines": {
        "node": ">=24.12.0",
        "pnpm": ">=9.0.0"
    },
    "packageManager": "pnpm@9.15.0",
    "scripts": {
        "dev": "turbo dev",
        "build": "turbo build",
        "lint": "turbo lint && pnpm lint:css",
        "lint:css": "stylelint \"**/*.{css,scss}\"",
        "desktop:dev": "pnpm -C apps/desktop dev",
        "desktop:build": "pnpm -C apps/desktop build",
        "desktop:lint": "pnpm -C apps/desktop lint",
        "clean": "turbo clean && rm -rf node_modules",
        "docker:up": "docker compose up -d",
        "docker:down": "docker compose down",
        "docker:https": "docker compose -f docker-compose.yml -f infra/proxy/caddy/docker-compose.https.yml up -d",
        "docker:logs": "docker compose logs -f"
    },
    "devDependencies": {
        "@dvdevcz/eslint": "^0.4.0",
        "@dvdevcz/stylelint": "^0.1.0",
        "@types/node": "^24.0.0",
        "stylelint": "^16.10.0",
        "turbo": "^2.3.3",
        "typescript-plugin-css-modules": "^5.0.1",
        "typescript": "^5.9.2"
    }
}
