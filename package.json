{
    "name": "stagistic",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Cloud editor for theatre and musical scripts",
    "license": "MIT",
    "author": "Stagistic Team",
    "engines": {
        "node": ">=24.12.0",
        "pnpm": ">=9.0.0"
    },
    "packageManager": "pnpm@9.15.0",
    "scripts": {
        "lint": "eslint . && stylelint \"**/*.{css,scss}\"",
        "typecheck": "tsc -b",
        "test": "vp test run",
        "test:watch": "vp test watch",
        "db:generate": "pnpm -C packages/db db:generate",
        "db:compile-migrations": "pnpm -C packages/db db:compile-migrations",
        "db:check": "pnpm -C packages/db db:check",
        "clean": "vp run -r clean && rm -rf node_modules",
        "docker:up": "docker compose up -d",
        "docker:down": "docker compose down",
        "docker:https": "docker compose -f docker-compose.yml -f infra/proxy/caddy/docker-compose.https.yml up -d",
        "docker:logs": "docker compose logs -f"
    },
    "devDependencies": {
        "@dvdevcz/eslint": "^0.4.0",
        "@dvdevcz/stylelint": "^0.1.0",
        "@types/node": "^24.13.1",
        "stylelint": "^16.26.1",
        "typescript": "^5.9.3",
        "typescript-plugin-css-modules": "^5.2.0",
        "vite-plus": "^0.1.24"
    }
}
