{
  "name": "remix-app-bootstrap",
  "packageManager": "yarn@4.9.1",
  "type": "module",
  "scripts": {
    "dev": "node ./server.js",
    "start": "cross-env NODE_ENV=production node ./server.js",
    "mikro-orm": "NODE_OPTIONS='--import tsx --no-warnings -r dotenv/config' mikro-orm",
    "migrations:create": "yarn mikro-orm migration:create",
    "migrations:up": "yarn mikro-orm migration:up",
    "migrations:down": "yarn mikro-orm migration:down",
    "auth:generate": "NODE_OPTIONS='--import tsx' npx @better-auth/cli generate --config auth.config.ts --output migrations/better-auth --yes",
    "auth:migrate": "NODE_OPTIONS='--import tsx' npx @better-auth/cli migrate --config auth.config.ts --yes",
    "auth:local:generate": "./scripts/auth-local.sh generate",
    "auth:local:migrate": "./scripts/auth-local.sh migrate",
    "migrate:generate": "yarn auth:generate",
    "migrate:apply": "yarn migrations:up; yarn auth:migrate",
    "migrate:local:generate": "yarn auth:local:generate",
    "migrate:local:apply": "./scripts/migrate-local.sh"
  },
  "devDependencies": {
    "@dvdevcz/eslint": "^0.4.0",
    "@dvdevcz/stylelint": "^0.1.0",
    "@dvdevcz/typescript-config": "^0.0.3",
    "@mikro-orm/cli": "^6.4.14",
    "@remix-run/dev": "^2.16.5",
    "@types/convict": "^6",
    "@types/express": "^4",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/pg": "^8",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "cross-env": "^7.0.3",
    "eslint": "^9.26.0",
    "postcss": "^8.5.3",
    "postcss-preset-mantine": "^1.17.0",
    "postcss-simple-vars": "^7.0.1",
    "stylelint": "^16.19.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "dependencies": {
    "@conform-to/react": "^1.5.0",
    "@conform-to/valibot": "^1.5.0",
    "@mantine/core": "^8.0.0",
    "@mantine/dates": "^8.0.0",
    "@mantine/dropzone": "^8.0.0",
    "@mantine/hooks": "^8.0.0",
    "@mantine/modals": "^8.0.0",
    "@mantine/notifications": "^8.0.0",
    "@mantine/spotlight": "^8.0.0",
    "@mikro-orm/core": "^6.4.14",
    "@mikro-orm/migrations": "^6.4.14",
    "@mikro-orm/postgresql": "^6.4.14",
    "@mikro-orm/reflection": "^6.4.14",
    "@mikro-orm/sql-highlighter": "^1.0.1",
    "@mjackson/headers": "^0.10.0",
    "@remix-run/express": "^2.16.5",
    "@remix-run/node": "^2.16.5",
    "@remix-run/react": "^2.16.5",
    "better-auth": "^1.3.24",
    "convict": "^6.2.4",
    "cookie-es": "^2.0.0",
    "dotenv": "^16.5.0",
    "express": "4",
    "isbot": "4",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.508.0",
    "nanoid": "^5.1.5",
    "neverthrow": "^8.2.0",
    "pg": "^8.16.3",
    "postmark": "^4.0.5",
    "react": "18",
    "react-dom": "18",
    "reflect-metadata": "^0.2.2",
    "valibot": "^1.1.0"
  },
  "mikro-orm": {
    "alwaysAllowTs": true,
    "useTsNode": false,
    "configPaths": [
      "./app/lib/db/mikro-orm.config.ts"
    ]
  }
}
