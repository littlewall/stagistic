{
    "hooks": {
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && node tools/agent-flows/bin/upstream.mjs session-start",
                        "timeout": 20
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Write|Edit|MultiEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"$CLAUDE_PROJECT_DIR/scripts/agent-fix.mjs\"",
                        "timeout": 60
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"$CLAUDE_PROJECT_DIR/scripts/agent-fix.mjs\"",
                        "timeout": 240
                    }
                ]
            }
        ]
    },
    "enabledPlugins": {
        "mattpocock-skills@claude-plugins-official": true,
        "superpowers@claude-plugins-official": false
    }
}
